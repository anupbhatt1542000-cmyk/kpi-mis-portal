PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kpi_portal
DB_USER=kpi_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# Phase 7 production security
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
AUTH_TOKEN_TTL_SECONDS=28800
BOOTSTRAP_ADMIN_ID=CHANGE_ME_ADMIN_ID
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_TEMP_PASSWORD
# In production, BOOTSTRAP_ADMIN_PASSWORD must be strong: 10+ chars with upper/lower/number/special.

# Phase 8-12 reporting/deployment
SERVE_FRONTEND=false
FRONTEND_DIST=../../client/dist
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
